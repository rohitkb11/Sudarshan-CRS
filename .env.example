# Tool executable names inside the orchestrator environment.
CLANG_BIN=clang
MAKE_BIN=make

# Hard limits for the bounded Phase 0 fuzzing campaign.
FUZZ_TIME_SECONDS=10
FUZZ_RUNS=100000
FUZZ_MAX_INPUT_BYTES=256
DIFFERENTIAL_FUZZ_RUNS=2000
COMMAND_TIMEOUT_SECONDS=30

# Reserved for the Stage 5 LLM fallback. It is not used by Phase 0.
ANTHROPIC_API_KEY=
