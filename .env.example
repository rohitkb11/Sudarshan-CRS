# Tool executable names inside the orchestrator environment.
CLANG_BIN=clang
MAKE_BIN=make

# Hard limits for the bounded fuzzing campaign.
FUZZ_TIME_SECONDS=10
FUZZ_RUNS=100000
FUZZ_MAX_INPUT_BYTES=256
DIFFERENTIAL_FUZZ_RUNS=2000
COMMAND_TIMEOUT_SECONDS=30

# Retry cap for the patch -> verify loop (README §5.2, Stage 6).
RETRY_CAP=3

# Primary LLM Provider: "groq" (ultra-fast inference) or "anthropic"
LLM_PROVIDER=groq

# Groq API Configuration (Tier 3 Automated Reasoning & Patch Generation)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY= 
GROQ_MODEL_FAST=
GROQ_MODEL_STRONG=
GROQ_TEMPERATURE=0
GROQ_TOP_P=0
GROQ_MAX_COMPLETION_TOKENS=
GROQ_REASONING_EFFORT=

# Anthropic API Configuration (Alternative / Fallback)
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-3-5-haiku-20241022
LLM_MODEL_STRONG=claude-sonnet-4-20250514
